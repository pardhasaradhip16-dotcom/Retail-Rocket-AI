# ==========================================
# RetailRocket AI — Environment Variables
# ==========================================

# Port for Unified Express Server
PORT=5000

# Environment Mode (development | production)
NODE_ENV=development

# JWT Secret for User & Judge Authentication
JWT_SECRET=retailrocket-super-secret-jwt-key-2026

# MongoDB Connection String:
# Option A: Local MongoDB (Default)
MONGO_URI=mongodb://127.0.0.1:27017/retailrocket

# Option B: Cloud MongoDB Atlas (for Render / Vercel deployment)
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/retailrocket?retryWrites=true&w=majority

# Frontend API URL (leave empty when using unified localhost:5000 or Render 1-URL service)
# Only required if frontend is hosted separately on Vercel:
# VITE_API_URL=https://<your-backend-app>.onrender.com
